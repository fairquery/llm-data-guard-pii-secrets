{
    "name": "llm-data-guard-pii-secrets",
    "version": "1.0.0",
    "type": "module",
    "description": "Detect and redact PII and secrets (API keys, tokens, private keys) in text and documents before sending them to LLMs (Fairquery).",
    "engines": {
        "node": ">=20"
    },
    "dependencies": {
        "apify": "^3.7.0",
        "cheerio": "^1.2.0",
        "compromise": "^14.14.0",
        "libphonenumber-js": "^1.12.0",
        "unpdf": "^1.0.0"
    },
    "devDependencies": {
        "@apify/eslint-config": "^2.0.0",
        "@apify/tsconfig": "^0.2.0",
        "@types/node": "^24.0.0",
        "eslint": "^9.29.0",
        "eslint-config-prettier": "^10.1.5",
        "globals": "^17.0.0",
        "prettier": "^3.5.3",
        "tsx": "^4.20.3",
        "typescript": "^5.8.0",
        "typescript-eslint": "^8.58.0",
        "vitest": "^5.0.5"
    },
    "scripts": {
        "start": "npm run start:dev",
        "start:prod": "node dist/main.js",
        "start:dev": "tsx src/main.ts",
        "build": "tsc",
        "lint": "eslint",
        "test": "vitest run"
    },
    "author": "Fairquery",
    "license": "MIT",
    "overrides": {
        "basic-ftp": "^6.2.3"
